# Copy to secrets.yaml (gitignored) and fill in. Never commit the real file — spec §8.
#
#   cp esphome/secrets.yaml.example esphome/secrets.yaml
#
# Generate the API key with:  openssl rand -base64 32

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Fallback hotspot the node raises if it cannot reach the AP — the way back in when the
# node is up a pole and the WiFi has changed. Minimum 8 characters.
ap_password: "fallback-password"

api_encryption_key: "base64-32-bytes-here"
ota_password: "your-ota-password"
